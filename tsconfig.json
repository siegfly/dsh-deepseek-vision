      "@deepseek-ai/cosmokit": ["../deepseek-harness/vendor/cosmokit/lib/types/index.d.ts"],
      "@deepseek-ai/schemastery": ["../deepseek-harness/vendor/schemastery/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-anonymous-user-id": ["../deepseek-harness/packages/identity/anonymous-user-id/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-attachment": ["../deepseek-harness/packages/attachment/attachment/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-brand": ["../deepseek-harness/packages/util/brand/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-credentials": ["../deepseek-harness/packages/credentials/credentials/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-home-paths": ["../deepseek-harness/packages/util/home-paths/lib/types/index.d.ts"],
