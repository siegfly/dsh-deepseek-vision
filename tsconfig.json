      "@deepseek-ai/dsh-llm-deepseek": ["../deepseek-harness/packages/llm/llm-deepseek/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-settings": ["../deepseek-harness/packages/settings/settings/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-timeout": ["../deepseek-harness/packages/util/timeout/lib/types/index.d.ts"]
